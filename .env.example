# ─────────────────────────────────────────────
# Vybe — Root Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# Environment (set to "production" for deployed environments)
NODE_ENV=development

# Gateway
GATEWAY_PORT=8000
FRONTEND_URL=http://localhost:5173

# Shared JWT Secret (same across all services that verify auth)
JWT_SECRET=your_jwt_secret_here

# MongoDB (used by docker-compose override; services use MONGODB_URL)
MONGODB_URL=mongodb://mongodb:27017/socialMedia

# Redis
REDIS_URL=redis://redis:6379

# Kafka
KAFKA_BROKERS=kafka:9092
# Confluent Cloud SASL/SSL (leave empty for local dev)
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Cloudinary (shared by user-service, content-service, messaging-service)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email / Nodemailer (used by auth-service)
EMAIL=your_email@gmail.com
EMAIL_PASS=your_email_app_password
